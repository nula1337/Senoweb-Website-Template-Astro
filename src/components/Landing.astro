---
export type Breadcrumb = {
	title: string;
	url?: string;
};

interface Props {
	heading: string;
	breadcrumbs?: Breadcrumb[];
}

const { heading, breadcrumbs = [] } = Astro.props;
---

<div class="relative z-10 px-fluid-4-8 py-fluid-16-24">
	<div class="container m-auto flex flex-col items-start gap-8">
		<span class="text-4xl">{heading}</span>

		{
			breadcrumbs.length > 0 && (
				<ul class="flex flex-wrap items-center justify-center gap-4">
					{breadcrumbs.map((item, index) => {
						const isLast = index === breadcrumbs.length - 1;
						return (
							<>
								<li>
									{item.url && !isLast ? (
										<a class="text-muted-foreground hover:text-foreground" href={item.url}>
											{item.title}
										</a>
									) : (
										<span class:list={[isLast ? "line-clamp-1 text-foreground" : "text-muted-foreground"]}>
											{item.title}
										</span>
									)}
								</li>
								{!isLast && (
									<li class="text-muted-foreground" aria-hidden="true">
										<svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
											<path d="M9.9,8.8L6.5,5.3l0.8-0.8l4.2,4.2L7.3,13l-0.8-0.8L9.9,8.8z" />
										</svg>
									</li>
								)}
							</>
						);
					})}
				</ul>
			)
		}
	</div>
</div>
