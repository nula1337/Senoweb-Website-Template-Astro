---
import { site } from "@/config/site";
import { defaultLocale, type Locale } from "@/i18n/locales";
import { t } from "@/i18n/ui";

interface Props {
	locale?: Locale;
}

const locale = Astro.props.locale ?? (Astro.currentLocale as Locale | undefined) ?? defaultLocale;
const year = new Date().getFullYear();
---

<footer class="border-t border-border px-fluid-4-8 py-fluid-12-16">
	<div class="container m-auto flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
		<div class="flex flex-col gap-2">
			<p class="font-semibold">{site.name}</p>
			<p class="text-sm text-muted-foreground">
				{site.address.lineOne}, {site.address.zip} {site.address.city}
			</p>
			<p class="text-sm text-muted-foreground">IČO {site.ico}</p>
		</div>

		<div class="flex flex-col gap-2 text-sm">
			<a class="hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
			<a class="hover:underline" href={`tel:${site.phoneForTel}`}>{site.phoneFormatted}</a>
			<a class="hover:underline" href="/gdpr/">GDPR</a>
		</div>
	</div>

	<div class="container m-auto mt-8 text-sm text-muted-foreground">
		© {year} {site.name}. {t(locale, "footer", "rights")}
	</div>
</footer>
