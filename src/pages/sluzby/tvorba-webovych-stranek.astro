---
import Landing from "@/components/Landing.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

import { defaultLocale } from "@/i18n/locales";
---

<BaseLayout
	title="Tvorba webových stránek"
	description="Tvorba webových stránek na míru — rychlé, čisté a bez zbytečného kódu."
	locale={defaultLocale}
>
	<Landing
		heading="Tvorba webových stránek"
		breadcrumbs={[
			{ title: "Domů", url: "/" },
			{ title: "Služby", url: "/sluzby/" },
			{ title: "Tvorba webových stránek" },
		]}
	/>

	<section class="px-fluid-4-8 py-fluid-16-24">
		<div class="container m-auto flex flex-col gap-fluid-4-8">
			<hgroup class="flex flex-col gap-fluid-2-4">
				<span class="topper">Služby</span>
				<h2 class="text-fluid-2xl-5xl font-bold">Weby, které fungují</h2>
			</hgroup>
			<p class="max-w-3xl text-muted-foreground">
				Stavíme weby od návrhu struktury po nasazení. Tato stránka zatím obsahuje zástupný text —
				doplňte sem konkrétní popis služby, procesu a výstupů.
			</p>
		</div>
	</section>
</BaseLayout>
