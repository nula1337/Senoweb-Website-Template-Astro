---
import Landing from "@/components/Landing.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

import { defaultLocale } from "@/i18n/locales";
---

<BaseLayout
	title="Webdesign"
	description="Webdesign na míru — vizuální návrh a uživatelské rozhraní pro váš web."
	locale={defaultLocale}
>
	<Landing
		heading="Webdesign"
		breadcrumbs={[
			{ title: "Domů", url: "/" },
			{ title: "Služby", url: "/sluzby/" },
			{ title: "Webdesign" },
		]}
	/>

	<section class="px-fluid-4-8 py-fluid-16-24">
		<div class="container m-auto flex flex-col gap-fluid-4-8">
			<hgroup class="flex flex-col gap-fluid-2-4">
				<span class="topper">Služby</span>
				<h2 class="text-fluid-2xl-5xl font-bold">Design s jasným směrem</h2>
			</hgroup>
			<p class="max-w-3xl text-muted-foreground">
				Navrhujeme vzhled a rozhraní tak, aby podporovaly cíle webu. Tato stránka zatím obsahuje
				zástupný text — doplňte sem konkrétní popis služby a přístupu.
			</p>
		</div>
	</section>
</BaseLayout>
