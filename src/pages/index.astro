---
import OptimizedImage from "@/components/OptimizedImage.astro";
import SeoSchemaHome from "@/components/SeoSchemaHome.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

import { site } from "@/config/site";

import { defaultLocale } from "@/i18n/locales";

import ogLogo from "@/assets/images/og-logo.png";
---

<BaseLayout
	title="Efektivní weby na míru"
	description="V Senoweb se specializujeme na tvorbu webových stránek na míru. Nepoužíváme koupené šablony, nástroje pro automatizované budování webů ani nástroje, které by váš web zahlcovali zbytečným kódem a tím vaší stránku zpomalovaly."
	locale={defaultLocale}
>
	<SeoSchemaHome slot="head" pageUrl="/" image="/assets/images/og-logo.png" />

	<section class="bg-background px-fluid-4-8 py-fluid-16-24">
		<div class="container m-auto flex flex-col gap-8">
			<div class="flex flex-col gap-2">
				<p class="text-sm font-medium text-primary">Senoweb</p>
				<h1 class="text-fluid-2xl-5xl font-semibold">Efektivní weby na míru</h1>
			</div>
			<OptimizedImage src={ogLogo} alt={`${site.name} logo`} class="max-w-md" priority />
		</div>
	</section>
</BaseLayout>
