---
import { Button } from "@/components/starwind/button";
import { defaultLocale } from "@/i18n/locales";
import { t } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
	title="Děkujeme za odeslání formuláře"
	description="Vaše odeslání formuláře bylo úspěšně doručeno."
	noindex
	locale={defaultLocale}
>
	<section class="flex min-h-[60vh] items-center px-fluid-4-8 py-fluid-16-24">
		<div class="container m-auto flex max-w-xl flex-col items-start gap-6">
			<h1 class="text-fluid-2xl-5xl font-semibold">Děkujeme!</h1>
			<p class="text-muted-foreground">Vaše zpráva byla v pořádku odeslána.</p>
			<Button as="a" href="/" id="thankyou-back">{t(defaultLocale, "thankyou", "back")}</Button>
		</div>
	</section>
</BaseLayout>

<script>
	const link = document.getElementById("thankyou-back");
	if (link instanceof HTMLAnchorElement) {
		const referrer = document.referrer;
		try {
			if (referrer && new URL(referrer).host === window.location.host) {
				link.href = referrer;
			}
		} catch {
			/* keep home */
		}
	}
</script>
